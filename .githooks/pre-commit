#!/usr/bin/env bash
# The commit check. On after `mise run dev:hooks`, or the first `mise run dev:test` (worktrees share it).
#   1. every task in tasks.toml has a step in the test, and every step names a real task
#   2. the docs site's config and the generated pages are what charter would write (docs -check)
#   3. docs/ passes charter's lint: front matter, dead links, tasks and paths that do not exist
# charter is in this repo's [tools]; where it is not installed, 2 and 3 are skipped.
# 0. tests/ and scripts/ type-check (mise run dev:types), when one of them is in the commit
git diff --cached --quiet -- scripts tests tsconfig.json || mise run dev:types >/dev/null 2>&1 || { mise run dev:types; echo "pre-commit: tests/ or scripts/ does not type-check (mise run dev:types)."; exit 1; }
git diff --cached --quiet -- tasks.toml tests mise.toml docs README.md AGENTS.md charter.toml && exit 0
node tests/record.mjs --coverage >/dev/null || exit 1
command -v charter >/dev/null 2>&1 || exit 0
charter docs -check >/dev/null || { echo "pre-commit: a generated page or the docs site's config is stale. Run  mise run docs:setup  and add what it changes."; exit 1; }
charter docs-lint >/dev/null || { charter docs-lint; echo "pre-commit: charter's docs lint found the problems above."; exit 1; }
