#!/usr/bin/env bash
# Keeps three things from drifting apart: tasks.toml, the test, and the pages built from them.
# Turned on by `mise run hooks` (once per clone; worktrees share it). About two seconds.
# charter (the owner's tool, in this repo's [tools]) wrote the docs site's config: the same in every
# repo of the owner's. If someone edited it by hand, say so. Skipped where charter is not installed.
if ! git diff --cached --quiet -- docs/_config.yml docs/_sass docs/writing.md docs/llms.txt && command -v charter >/dev/null 2>&1; then
	charter docs -check >/dev/null || { echo "pre-commit: the docs site's config differs from charter's. Run  mise run docs:setup  — or change it in charter."; exit 1; }
fi
git diff --cached --quiet -- tasks.toml tests/replay.sh tests/status.mjs README.md && exit 0
node tests/status.mjs --coverage >/dev/null || exit 1
node tests/status.mjs --rebuild >/dev/null || exit 1
if ! git diff --quiet -- README.md docs; then
	echo "pre-commit: the pages built from tasks.toml and the README were out of date and have been rebuilt:"
	git diff --name-only -- README.md docs
	echo "Add them to this commit and commit again."
	exit 1
fi
