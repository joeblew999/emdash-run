{
  "mcpServers": {
    "emdash": {
      "type": "http",
      "url": "http://localhost:4321/_emdash/api/mcp",
      "headers": {
        "Authorization": "Bearer ${EMDASH_MCP_TOKEN}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/mise",
      "args": [
        "x", "--",
        "bunx", "@playwright/mcp@latest"
      ]
    }
  }
}
