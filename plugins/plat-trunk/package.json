{
	"name": "@plat-trunk/emdash-plugin",
	"version": "0.1.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./admin": {
			"types": "./src/admin/index.tsx",
			"default": "./src/admin/index.tsx"
		}
	},
	"files": [
		"src"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"bundle": "emdash-plugin bundle",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run"
	},
	"peerDependencies": {
		"emdash": "^1.1.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@emdash-cms/plugin-cli": "^0.13.2",
		"@emdash-cms/plugin-test": "^0.2.7",
		"@types/react": "^19.0.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0"
	}
}
