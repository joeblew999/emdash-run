{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"declaration": true,
		"outDir": "./dist",
		"rootDir": "./src",
		// `emdash` re-exports optional storage drivers (unstorage) whose .d.ts files
		// reference packages we never install — mongodb, ioredis, @vercel/kv, @deno/kv…
		// Skipping dependency declarations is the standard fix; our own code is still
		// fully checked.
		"skipLibCheck": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
