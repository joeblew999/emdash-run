{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emdash-run",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],

	// D1 database — provisioned by the first `mise run site:deploy`.
	// Local dev uses miniflare state under .wrangler/state; the id is only used remotely.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emdash-run",
			"database_id": "115eb6d3-43df-4139-95bb-7900512ced12",
		},
	],

	// R2 bucket for media storage (created by `wrangler r2 bucket create emdash-run-media`)
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "emdash-run-media",
		},
	],

	// Worker Loader — required by the plugin sandbox runner (sandbox()).
	// Sandboxed plugins run as Dynamic Workers through this binding.
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],

	// KV for session storage (@astrojs/cloudflare sessions). Real namespace id —
	// the local placeholder ("SESSION") is rejected by a real deploy.
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "29c6fd5b70644857a4ffbcf359973841",
		},
	],

	// General maintenance cron trigger (matches the template).
	"triggers": {
		"crons": ["* * * * *"],
	},

	// Plugin discovery uses the hosted registry (registry.emdashcms.com), enabled by
	// emdash's `sandboxRunner`; no service binding is needed.
}
