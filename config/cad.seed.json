{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "emdash-run CAD seed",
		"description": "Hand-maintained, not a database export. Each part carries a model_id pointing at a plat-trunk model in the cad-documents R2 bucket, plus geometry_meta holding a snapshot of that model manifest.json read on 2026-10-05. Tessellation stats (vertices/faces/volume) are deliberately absent: they are properties of the model scene.json, not its manifest, and nothing here computes them yet."
	},
	"collections": [
		{
			"slug": "assemblies",
			"label": "Assemblies",
			"labelSingular": "Assembly",
			"description": "Assembly hierarchy nodes",
			"fields": [
				{
					"slug": "name",
					"label": "Name",
					"type": "string",
					"required": true
				},
				{
					"slug": "project",
					"label": "Project",
					"type": "reference",
					"required": true
				},
				{
					"slug": "parent",
					"label": "Parent Assembly",
					"type": "reference"
				},
				{
					"slug": "metadata",
					"label": "Geometry Metadata",
					"type": "json"
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"supports": [
				"drafts",
				"revisions",
				"search"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		},
		{
			"slug": "parts",
			"label": "Parts",
			"labelSingular": "Part",
			"description": "Individual CAD parts with geometry",
			"supports": [
				"drafts",
				"revisions"
			],
			"fields": [
				{
					"slug": "name",
					"label": "Name",
					"type": "string",
					"required": true
				},
				{
					"slug": "part_number",
					"label": "Part Number",
					"type": "string"
				},
				{
					"slug": "assembly",
					"label": "Assembly",
					"type": "reference",
					"required": true
				},
				{
					"slug": "model_id",
					"label": "Model",
					"type": "string"
				},
				{
					"slug": "material",
					"label": "Material",
					"type": "select"
				},
				{
					"slug": "geometry_meta",
					"label": "Geometry",
					"type": "json"
				}
			]
		},
		{
			"slug": "posts",
			"label": "Posts",
			"labelSingular": "Post",
			"supports": [
				"drafts",
				"revisions",
				"search"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Featured Image",
					"type": "image"
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "excerpt",
					"label": "Excerpt",
					"type": "text"
				}
			]
		},
		{
			"slug": "projects",
			"label": "Projects",
			"labelSingular": "Project",
			"description": "Top-level CAD projects",
			"fields": [
				{
					"slug": "name",
					"label": "Name",
					"type": "string",
					"required": true
				},
				{
					"slug": "description",
					"label": "Description",
					"type": "text"
				},
				{
					"slug": "metadata",
					"label": "Metadata",
					"type": "json"
				}
			]
		}
	],
	"taxonomies": [
		{
			"name": "category",
			"label": "Categories",
			"labelSingular": "Category",
			"hierarchical": true,
			"collections": [
				"posts"
			]
		},
		{
			"name": "tag",
			"label": "Tags",
			"labelSingular": "Tag",
