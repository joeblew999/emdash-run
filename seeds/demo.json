	"content": {
		"pages": [
			{
				"id": "page-about",
				"slug": "about",
				"status": "published",
				"data": {
					"title": "About",
					"content": [
						{
							"_type": "block",
							"_key": "b0",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b0s0",
									"text": "EmDash Demo is a small collection of notes on making websites carefully: what to decide before a page is built, what to leave out, and when to stop.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "b1",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b1s0",
									"text": "It is also a demonstration. Every post, page, menu and widget here was put in place from a seed file, to show what a site looks like with something in each corner. The notes are real enough to read, and none of them is advice you have to take.",
									"marks": []
								}
							]
						}
					]
				}
			},
