			{
				"id": "post-sketch-it-on-paper-first",
				"slug": "sketch-it-on-paper-first",
				"status": "published",
				"data": {
					"title": "Sketch It on Paper First",
					"excerpt": "Ten minutes with a pencil settles questions that an hour in the editor only postpones. Here is the routine we use before any page is built.",
					"featured_image": {
						"$media": {
							"url": "https://images.unsplash.com/photo-1523726491678-bf852e717f6a?w=1200&h=800&fit=crop",
							"alt": "An open notebook covered in hand-drawn page sketches, a pencil resting on it",
							"filename": "sketch-it-on-paper-first.jpg"
						}
					},
					"content": [
						{
							"_type": "block",
							"_key": "b0",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b0s0",
									"text": "Before a page of this site exists anywhere a visitor could find it, it exists as a rectangle in a notebook. Not a design: a rectangle, with a few scribbled lines for the words and a box where a picture might go.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "b1",
							"style": "normal",
							"markDefs": [
								{
									"_type": "link",
									"_key": "b1l1",
									"href": "https://emdashcms.com"
								}
							],
							"children": [
								{
									"_type": "span",
									"_key": "b1s0",
									"text": "The habit comes from print, where changing your mind was expensive, and it survives because it still works. A pencil is fast, and a page drawn with one cannot be made to look finished, which is the point. (The site itself is kept in ",
									"marks": []
								},
								{
									"_type": "span",
									"_key": "b1s1",
									"text": "EmDash",
									"marks": [
										"b1l1"
									]
								},
								{
									"_type": "span",
									"_key": "b1s2",
									"text": ", but that comes later.)",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "b2",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b2s0",
									"text": "The ten-minute routine",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "b3",
							"style": "normal",
							"listItem": "bullet",
							"level": 1,
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b3s0",
									"text": "Write the one sentence a reader should leave with. If there are two, there are two pages.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "b4",
							"style": "normal",
							"listItem": "bullet",
							"level": 1,
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b4s0",
									"text": "Draw the page as boxes, top to bottom, in the order a reader meets them.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "b5",
							"style": "normal",
							"listItem": "bullet",
							"level": 1,
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b5s0",
									"text": "Cross out one box. There is always one.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "b6",
							"style": "normal",
							"listItem": "bullet",
							"level": 1,
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b6s0",
									"text": "Only then open the editor.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "b7",
							"style": "blockquote",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b7s0",
									"text": "If it does not work as a sketch, it will not work with nicer type.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "b8",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b8s0",
									"text": "What changes",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "b9",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b9s0",
									"text": "The pages get shorter. Not because anyone is counting words, but because a box drawn by hand has to earn its place, and a paragraph pasted into an editor does not.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "b10",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b10s0",
									"text": "Keep the sketches. Six months on, the notebook is the quickest way to remember why a page is the shape it is.",
									"marks": []
								}
							]
						}
					]
				},
				"taxonomies": {
					"category": [
						"tutorials"
					],
					"tag": [
						"process",
						"tools"
					]
				},
				"bylines": [
					{
						"byline": "byline-demo-editor"
					}
				]
			},
			{
				"id": "post-notes-for-the-next-redesign",
				"slug": "notes-for-the-next-redesign",
				"status": "draft",
				"data": {
					"title": "Notes for the Next Redesign",
					"excerpt": "Things we would do differently, collected as we go.",
					"content": [
						{
							"_type": "block",
							"_key": "b0",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b0s0",
									"text": "Fewer templates. Bigger type. One navigation, not two. This list is still growing, and it is not ready for readers.",
									"marks": []
								}
							]
						}
					]
				},
				"taxonomies": {
