				}
			},
			{
				"id": "post-what-we-are-reading",
				"slug": "what-we-are-reading",
				"status": "draft",
				"data": {
					"title": "What We Are Reading",
					"excerpt": "Three books and two essays that changed how we plan a page.",
					"featured_image": {
						"$media": {
							"url": "https://images.unsplash.com/photo-1497366216548-37526070297c?w=1200&h=800&fit=crop",
							"alt": "A quiet, empty office with a low bookshelf and a sofa against a dark wall",
							"filename": "what-we-are-reading.jpg"
						}
					},
					"content": [
						{
							"_type": "block",
							"_key": "b0",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b0s0",
									"text": "Most of what we know about making websites came from people who wrote it down. Each season we pass a short list around; this is the current one.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "b1",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b1s0",
									"text": "Books",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "b2",
							"style": "normal",
							"listItem": "bullet",
							"level": 1,
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b2s0",
									"text": "A style manual, read slowly: it is a book about making a decision once.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "b3",
							"style": "normal",
							"listItem": "bullet",
							"level": 1,
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b3s0",
									"text": "A history of the printed page, for everything it settled before screens existed.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "b4",
							"style": "normal",
							"listItem": "bullet",
							"level": 1,
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b4s0",
									"text": "A book on finding your way around buildings, which turns out to be about navigation menus.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "b5",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b5s0",
									"text": "Essays",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "b6",
							"style": "normal",
							"listItem": "bullet",
							"level": 1,
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b6s0",
									"text": "One on writing headings that say what the section says.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "b7",
							"style": "normal",
							"listItem": "bullet",
							"level": 1,
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b7s0",
									"text": "One on why a short page is a kindness.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "b8",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "b8s0",
									"text": "If a favourite of yours belongs here, tell us. The list is better every time somebody argues with it.",
									"marks": []
								}
							]
