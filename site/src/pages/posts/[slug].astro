---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText, WidgetArea } from "emdash/ui";
import { Comments, CommentForm } from "emdash/ui/comments";
import Base from "../../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

// SEO meta from content fields
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

// Taxonomy terms are already hydrated onto the entry by getEmDashEntry.
const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];

// Bylines are already hydrated onto the entry by getEmDashEntry.
const bylines = (post.data.bylines ?? []).map(({ byline, roleLabel }) => ({
	name: byline.displayName,
	role: roleLabel,
	avatar: byline.avatarStorageKey
		? (Astro.locals.emdash?.getPublicMediaUrl?.(byline.avatarStorageKey) ??
			`/_emdash/api/media/file/${byline.avatarStorageKey.split("/").map(encodeURIComponent).join("/")}`)
		: null,
}));
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article>
		{
			post.data.featured_image && (
				<div {...post.edit.featured_image}>
					<Image image={post.data.featured_image} />
				</div>
			)
		}

		<h1 {...post.edit.title}>{post.data.title}</h1>

		{
			post.data.publishedAt && (
				<time datetime={post.data.publishedAt.toISOString()}>
					{post.data.publishedAt.toLocaleDateString("en-US", {
						year: "numeric",
						month: "long",
						day: "numeric",
					})}
				</time>
			)
		}

		{
			bylines.length > 0 && (
				<p>
					{bylines.map((author, index) => (
						<span>
							{index > 0 && ", "}
							{author.avatar && (
								<img
									src={author.avatar}
									alt=""
									width="32"
									height="32"
									style="border-radius:50%;object-fit:cover;display:inline-block;vertical-align:middle;margin-inline-end:0.4em;"
								/>
							)}
							{author.name}
							{author.role && <em> ({author.role})</em>}
						</span>
					))}
				</p>
			)
		}

		{
			categories.length > 0 && (
				<div>
					{categories.map((c) => (
						<a href={`/category/${c.slug}`}>{c.label}</a>
					))}
				</div>
			)
		}

		<PortableText value={post.data.content} />

		{
			tags.length > 0 && (
				<div>
					{tags.map((t) => (
						<a href={`/tag/${t.slug}`}>{t.label}</a>
					))}
				</div>
			)
		}

		<Comments collection="posts" contentId={post.data.id} threaded />
		<CommentForm collection="posts" contentId={post.data.id} />
	</article>

	<aside>
		<WidgetArea name="sidebar" />
	</aside>
</Base>
